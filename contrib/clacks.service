# Reference unit for a `go install` layout (binary at ~/go/bin/clacks).
# Prefer `clacks daemon install`, which writes this unit with the running
# binary's absolute path, and `clacks daemon install --enable` to start it.
[Unit]
Description=clacks sync daemon (encrypted sync for AI coding sessions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/go/bin/clacks daemon
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
